<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifeste de l'APK de test instrumenté uniquement (jamais fusionné dans l'application),
    même motif que :feature:ringing. `<queries>` permet à `startActivity` de résoudre
    `ACTION_SETTINGS` sur les appareils dont le manifeste cible restreint la visibilité des
    packages (Android 11+). `ComponentActivity` : activité hôte des tests Compose de l'écran 7
    (étape 39), comme dans :feature:ringing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <application>
        <!--
            Portrait imposé à l'activité hôte des tests seulement (jamais à l'app, SPEC_ANDROID §15 :
            « ne pas verrouiller l'orientation ») : les tests d'écran mesurent la mise en page des
            maquettes, dessinées en portrait. Téléphone posé en paysage avec la rotation automatique,
            la barre de navigation passe sur le côté et ces mesures échouaient (constaté le 2026-10-23).
        -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Niumi.Dark" />
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Visibilité des packages (SPEC_ANDROID §12.1, §14). Depuis Android 11, une application ne
        voit que ce qu'elle déclare : sans ce bloc, `PackageManagerPackageQuery` ne recevrait
        aucune application et le sélecteur serait vide. Déclaré ici, avec le seul code qui appelle
        `queryIntentActivities()`, plutôt que dans `:app`.

        La portée est volontairement minimale — les seules applications qui ont une icône dans le
        lanceur, exactement celles que l'utilisateur peut choisir de bloquer. La permission de
        visibilité totale des paquets reste interdite (§14) : elle déclencherait une justification
        auprès de Google Play. Son nom n'est volontairement pas écrit ici, pour qu'un `grep` sur le
        manifeste fusionné reste une vérification fiable (critère de fin de l'étape 13).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!--
            Reprogrammation et réconciliation sur événement système (SPEC_ANDROID §9.3).
            directBootAware : le receveur doit tourner avant le premier déverrouillage, sur
            LOCKED_BOOT_COMPLETED, et lire le snapshot Direct Boot comme unique source (§7.3).
            exported=false : les six actions sont des broadcasts protégés du système, aucune
            application tierce n'a à les simuler.

            USER_UNLOCKED est absent de cette liste, et ce n'est pas un oubli : Android ne le
            délivre qu'aux receveurs enregistrés à chaud, jamais à un receveur de manifeste.
            SystemEventsRegistrar l'enregistre depuis NiumiApplication. Les cinq actions
            ci-dessous sont, elles, bien délivrées à un receveur de manifeste : quatre figurent
            dans la liste officielle des exceptions aux restrictions de broadcasts implicites, et
            MY_PACKAGE_REPLACED est explicitement adressé au paquet lui-même.
        -->
        <receiver
            android:name="com.niumi.system.boot.SystemEventsReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Alarme de secours pendant RINGING (SPEC_ANDROID §10.2, §9.1 ; étape 20). Aucun
            intent-filter : ce receveur n'est jamais ciblé que par le PendingIntent explicite posé
            par AndroidRingingWatchdog.arm(), jamais par un broadcast système. directBootAware :
            une sonnerie peut commencer avant le premier déverrouillage (prouvé à l'étape 19).
        -->
        <receiver
            android:name="com.niumi.system.alarm.RingingWatchdogReceiver"
            android:exported="false"
            android:directBootAware="true" />
    </application>

</manifest>
